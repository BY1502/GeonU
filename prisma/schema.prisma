generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model User {
  id             String                   @id @default(cuid())
  email          String                   @unique
  passwordHash   String
  name           String?
  image          String?
  mealPosts      MealPost[]
  recipes        Recipe[]
  comments       Comment[]
  likes          Like[]
  participations ChallengeParticipation[]
  userBadges     UserBadge[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model MealPost {
  id                String               @id @default(cuid())
  userId            String
  title             String
  description       String
  cookingTimeMin    Int
  estimatedCostWon  Int
  imageUrls         String[]
  visibility        Visibility           @default(PUBLIC)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients       MealPostIngredient[]
  likes             Like[]
  comments          Comment[]
  challengeCheckins ChallengeCheckin[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Recipe {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String
  servings    Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  steps       RecipeStep[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RecipeStep {
  id          String   @id @default(cuid())
  recipeId    String
  stepOrder   Int
  instruction String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recipeId, stepOrder])
}

model Ingredient {
  id         String    @id @default(cuid())
  recipeId   String
  name       String
  quantity   Decimal   @db.Decimal(10, 2)
  unit       String
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealPosts  MealPostIngredient[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MealPostIngredient {
  id           String     @id @default(cuid())
  mealPostId   String
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  mealPost     MealPost   @relation(fields: [mealPostId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([mealPostId, ingredientId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  mealPostId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPost   MealPost @relation(fields: [mealPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, mealPostId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  mealPostId String
  content    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPost   MealPost @relation(fields: [mealPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mealPostId, createdAt])
}

model Challenge {
  id             String                   @id @default(cuid())
  code           String                   @unique
  title          String
  description    String
  weekStartDate  DateTime
  weekEndDate    DateTime
  targetCount    Int                      @default(5)
  isActive       Boolean                  @default(true)
  participations ChallengeParticipation[]
  badges         Badge[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model ChallengeParticipation {
  id            String            @id @default(cuid())
  userId        String
  challengeId   String
  currentCount  Int               @default(0)
  completedRate Int               @default(0)
  completedAt   DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  checkins      ChallengeCheckin[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, challengeId])
}

model ChallengeCheckin {
  id                String                   @id @default(cuid())
  participationId   String
  mealPostId        String
  checkinDate       DateTime
  participation     ChallengeParticipation   @relation(fields: [participationId], references: [id], onDelete: Cascade)
  mealPost          MealPost                 @relation(fields: [mealPostId], references: [id], onDelete: Cascade)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([participationId, checkinDate])
}

model Badge {
  id          String     @id @default(cuid())
  challengeId String
  name        String
  description String
  imageUrl    String?
  challenge   Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userBadges  UserBadge[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, badgeId])
}
